# Postgres connection. For `npm run db:local` use the value below as is.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/church_cms
DATABASE_POOL_MAX=5

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Protects the daily job. Vercel Cron sends it automatically when set in Vercel.
CRON_SECRET=

# The central admin, created or updated by `npm run db:seed`. At least 10 characters.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=

# Public address, used inside QR codes. Set this before printing any QR code.
APP_URL=http://localhost:3000
NEXT_PUBLIC_CHURCH_NAME=The Triumphant Family

# Decides what "today" means for sessions, e.g. Africa/Lagos, Europe/London.
CHURCH_TIMEZONE=UTC

# Business rule settings (section 5).
FIRST_TIMER_WINDOW_DAYS=30
FIRST_TIMER_FOLLOW_UP_DAYS=7
# Must stay above 3, so that "misses 2-3 straight" is an absence and not yet a drop-off.
DROP_OFF_MISSES=4
CHECKIN_RATE_LIMIT_PER_MINUTE=300
